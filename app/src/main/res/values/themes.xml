    <style name="Theme.EcuMapEditor.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#2C3E50</item>
        <item name="colorPrimaryVariant">#1A252F</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#27AE60</item>
        <item name="colorSecondaryVariant">#219653</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
